# Copy to .env (git-ignored). Everything here is optional.

# The Assistant runs on an open-weight model you host. Any OpenAI-compatible server works:
#   Ollama (default)   http://localhost:11434/v1
#   vLLM               http://localhost:8100/v1   (vllm serve <model> --port 8100; Fieldbook uses 8000)
#   LM Studio          http://localhost:1234/v1
#   llama.cpp server   http://localhost:8080/v1
# Leave FIELDBOOK_LLM_MODEL empty to use the built-in rules engine only.
FIELDBOOK_LLM_BASE_URL=http://localhost:11434/v1
# A model that reads photos too, e.g. qwen2.5vl:7b or gemma3:12b (pull it first: ollama pull qwen2.5vl:7b)
FIELDBOOK_LLM_MODEL=
# Optional: a separate model for photos, if FIELDBOOK_LLM_MODEL is text-only
FIELDBOOK_LLM_VISION_MODEL=
# Only for servers that require one (vLLM --api-key, hosted gateways). Ollama ignores it.
FIELDBOOK_LLM_API_KEY=
FIELDBOOK_LLM_TIMEOUT=180
# Characters of document text per request. ~4 characters per token; keep under the model's context.
FIELDBOOK_LLM_MAX_INPUT_CHARS=12000
FIELDBOOK_LLM_MAX_IMAGES=4
# auto | llm | rules
FIELDBOOK_ASSISTANT=auto

# Where the SQLite database and uploaded files live, and the address people open.
FIELDBOOK_DATA_DIR=data
FIELDBOOK_PUBLIC_URL=http://localhost:8000

# Local demos only: treat any browser without a login as the owner.
FIELDBOOK_DEV_AUTOLOGIN=0
