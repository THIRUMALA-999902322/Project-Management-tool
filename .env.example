# Copy to .env (git-ignored). Everything here is optional.

# Claude. With a key (or an `ant auth login` profile) the Assistant uses Claude;
# without one it uses the built-in rules engine.
ANTHROPIC_API_KEY=
# auto | claude | rules
FIELDBOOK_ASSISTANT=auto
FIELDBOOK_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
FIELDBOOK_CLAUDE_EFFORT=medium
FIELDBOOK_CLAUDE_MAX_TOKENS=16000

# Where the SQLite database and uploaded files live, and the address people open.
FIELDBOOK_DATA_DIR=data
FIELDBOOK_PUBLIC_URL=http://localhost:8000

# Local demos only: treat any browser without a login as the owner.
FIELDBOOK_DEV_AUTOLOGIN=0
